                <damageAmountBase>10</damageAmountBase>
              </projectile>
            </ThingDef>
          </value>
        </li>
        <li Class="PatchOperationAdd">
          <xpath>Defs</xpath>
          <value>
            <ThingDef ParentName="BaseBullet">
              <defName>GW_CE17_EarthshakerDetonation_AP</defName>
              <label>132mm AP shell detonation</label>
              <thingClass>CombatExtended.ProjectileCE_Explosive</thingClass>
              <graphicData>
                <texPath>Things/Projectile/ShellHighExplosive</texPath>
                <graphicClass>Graphic_Single</graphicClass>
              </graphicData>
              <projectile Class="CombatExtended.ProjectilePropertiesCE">
                <speed>30</speed>
                <damageDef>Bomb</damageDef>
                <explosionRadius>3.9</explosionRadius>
                <damageAmountBase>156</damageAmountBase>
              </projectile>
            </ThingDef>
          </value>
        </li>
        <li Class="PatchOperationReplace">
          <xpath>Defs/ThingDef[defName="GW_HOI_132mm_AP"]</xpath>
          <value>
            <ThingDef ParentName="GW_HOI_MakeableShellBase" Class="CombatExtended.AmmoDef">
              <defName>GW_HOI_132mm_AP</defName>
              <label>132mm AP shell</label>
              <description>A 132mm armor-piercing shell for the Earthshaker cannon, with a diamantine tip. It trades some of its blast radius for an increased ability to penetrate armor, making the gun able to damage and destroy even heavily-armored vehicles with a solid hit.</description>
              <possessionCount>1</possessionCount>
              <graphicData>
                <texPath>Things/Ammo/GW_HOI_EarthshakerAmmo/AP</texPath>
                <graphicClass>Graphic_StackCount</graphicClass>
              </graphicData>
              <comps>
              </comps>
              <projectileWhenLoaded>GW_HOI_Bullet_132mm_AP</projectileWhenLoaded>
              <costList>
                <Steel>60</Steel>
                <Chemfuel>25</Chemfuel>
              </costList>
              <recipeMaker>
                <researchPrerequisite>GW_AM_ImperiumDefense</researchPrerequisite>
              </recipeMaker>
              <thingClass>CombatExtended.AmmoThing</thingClass>
              <ammoClass>ArmorPiercing</ammoClass>
              <isMortarAmmo>true</isMortarAmmo>
              <spawnAsSiegeAmmo>false</spawnAsSiegeAmmo>
              <detonateProjectile>GW_CE17_EarthshakerDetonation_AP</detonateProjectile>
              <statBases>
                <Bulk>4.5</Bulk>
              </statBases>
            </ThingDef>
          </value>
        </li>
        <li Class="PatchOperationReplace">
          <xpath>Defs/ThingDef[defName="GW_HOI_Bullet_132mm_AP"]</xpath>
          <value>
            <ThingDef ParentName="BaseBullet">
              <defName>GW_HOI_Bullet_132mm_AP</defName>
              <label>armor-piercing shell</label>
              <graphicData>
                <texPath>Things/Projectile/ShellHighExplosive</texPath>
                <graphicClass>Graphic_Single</graphicClass>
                <shaderType>TransparentPostLight</shaderType>
              </graphicData>
              <thingClass>CombatExtended.BulletCE</thingClass>
              <projectile Class="CombatExtended.ProjectilePropertiesCE">
                <damageDef>Bullet</damageDef>
                <!-- damage amount is the damage def default -->
                <speed>30</speed>
                <damageAmountBase>50</damageAmountBase>
                <explosionRadius>0</explosionRadius>
                <flyOverhead>true</flyOverhead>
                <arcHeightFactor>0.4</arcHeightFactor>
                <soundHitThickRoof>Artillery_HitThickRoof</soundHitThickRoof>
                <soundExplode>MortarBomb_Explode</soundExplode>
                <soundImpactAnticipate>MortarRound_PreImpact</soundImpactAnticipate>
                <soundAmbient>MortarRound_Ambient</soundAmbient>
                <dropsCasings>false</dropsCasings>
                <armorPenetrationSharp>25</armorPenetrationSharp>
                <armorPenetrationBlunt>250</armorPenetrationBlunt>
              </projectile>
              <comps>
                <li Class="CombatExtended.CompProperties_ExplosiveCE">

<Patch>
  <Operation Class="PatchOperationConditional">
    <xpath>Defs/ThingDef[defName="GW_HOI_Artillery_Earthshaker" and not(comps/li[@Class="CombatExtended.CompProperties_AmmoUser"]) and not(verbs/li[starts-with(verbClass,"CombatExtended.")])]</xpath>
    <match Class="PatchOperationSequence">
      <operations>
        <li Class="PatchOperationAdd">
          <xpath>Defs</xpath>
          <value>
            <ThingDef ParentName="BaseBullet">
              <defName>GW_CE17_EarthshakerDetonation_HighExplosive</defName>
              <label>132mm HighExplosive shell detonation</label>
              <thingClass>CombatExtended.ProjectileCE_Explosive</thingClass>
              <graphicData>
                <texPath>Things/Projectile/ShellHighExplosive</texPath>
                <graphicClass>Graphic_Single</graphicClass>
              </graphicData>
              <projectile Class="CombatExtended.ProjectilePropertiesCE">
                <speed>30</speed>
                <damageDef>Bomb</damageDef>
                <explosionRadius>4.9</explosionRadius>
                <damageAmountBase>156</damageAmountBase>
              </projectile>
            </ThingDef>
          </value>
        </li>
        <li Class="PatchOperationReplace">
          <xpath>Defs/ThingDef[defName="GW_HOI_132mm_HighExplosive"]</xpath>
          <value>
            <ThingDef ParentName="GW_HOI_MakeableShellBase" Class="CombatExtended.AmmoDef">
              <defName>GW_HOI_132mm_HighExplosive</defName>
              <label>132mm high-explosive shell</label>
              <description>A 132mm high-explosive shell for the Earthshaker cannon, complete with a time fuze and fragmentation case. The most common round used in the Earthshaker by the Astra Militarum, suitable for blasting apart infantry, vehicles, and fortifications alike.</description>

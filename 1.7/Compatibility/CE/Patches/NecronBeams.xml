<Patch>
  <Operation Class="PatchOperationFindMod">
    <mods>
      <li>Combat Extended</li>
    </mods>
    <match Class="PatchOperationSequence">
      <operations>
        <li Class="PatchOperationConditional">
          <xpath>Defs/ThingDef[defName="GW40k_Necron_Laser" and @Class="VEF.Weapons.LaserBeamDef"]</xpath>
          <match Class="PatchOperationReplace">
            <xpath>Defs/ThingDef[defName="GW40k_Necron_Laser"]</xpath>
            <value>
              <ThingDef ParentName="GW40k_Necron_BulletLaser" Class="CombatExtended.Lasers.LaserBeamDefCE">
                <defName>GW40k_Necron_Laser</defName>
                <label>beam</label>
                <description>a viridian-green charged particle beam.</description>
                <textures>
                  <li>Things/Projectiles/TeslaCarbineMote</li>
                </textures>
                <seam>0.1</seam>
                <causefireChance>0</causefireChance>
                <beamWidth>1.2</beamWidth>
                <lifetime>60</lifetime>
                <!-- <explosionEffect>Ring_ExpandY</explosionEffect> -->
                <projectile Class="CombatExtended.ProjectilePropertiesCE">
                  <damageDef>Cut</damageDef>
                  <damageAmountBase>37</damageAmountBase>
                  <stoppingPower>3</stoppingPower>
                  <armorPenetrationSharp>26</armorPenetrationSharp>
                  <armorPenetrationBlunt>60</armorPenetrationBlunt>
                  <isInstant>true</isInstant>
                  <damageFalloff>false</damageFalloff>
                </projectile>
                <thingClass>CombatExtended.Lasers.LaserBeamCE</thingClass>
              </ThingDef>
            </value>
          </match>
        </li>
        <li Class="PatchOperationConditional">
          <xpath>Defs/ThingDef[defName="GW40k_Necron_Reaper" and @Class="VEF.Weapons.LaserBeamDef"]</xpath>
          <match Class="PatchOperationReplace">
            <xpath>Defs/ThingDef[defName="GW40k_Necron_Reaper"]</xpath>
            <value>
              <ThingDef ParentName="GW40k_Necron_BulletLaser" Class="CombatExtended.Lasers.LaserBeamDefCE">
                <defName>GW40k_Necron_Reaper</defName>
                <label>beam</label>
                <description>a viridian-green charged particle beam.</description>
                <textures>
                  <li>Things/Projectiles/Laser_Green</li>
                </textures>
                <seam>0.1</seam>
                <causefireChance>0</causefireChance>
                <beamWidth>0.9</beamWidth>
                <lifetime>55</lifetime>
                <!-- <explosionEffect>Ring_ExpandY</explosionEffect> -->
                <projectile Class="CombatExtended.ProjectilePropertiesCE">
                  <damageDef>Cut</damageDef>
                  <damageAmountBase>14</damageAmountBase>
                  <stoppingPower>3</stoppingPower>
                  <armorPenetrationSharp>22.5</armorPenetrationSharp>
                  <armorPenetrationBlunt>40</armorPenetrationBlunt>
                  <isInstant>true</isInstant>
                  <damageFalloff>false</damageFalloff>
                </projectile>
                <thingClass>CombatExtended.Lasers.LaserBeamCE</thingClass>
              </ThingDef>
            </value>
          </match>
        </li>
        <li Class="PatchOperationConditional">
          <xpath>Defs/ThingDef[defName="GW40k_Necron_Gauss" and @Class="VEF.Weapons.LaserBeamDef"]</xpath>
          <match Class="PatchOperationReplace">
            <xpath>Defs/ThingDef[defName="GW40k_Necron_Gauss"]</xpath>
            <value>
              <ThingDef ParentName="GW40k_Necron_BulletLaser" Class="CombatExtended.Lasers.LaserBeamDefCE">
                <defName>GW40k_Necron_Gauss</defName>
                <label>Particle Beam</label>
                <description>beam</description>
                <textures>
                  <li>Things/Projectiles/Laser_Green</li>
                </textures>
                <seam>0.1</seam>
                <causefireChance>0</causefireChance>
                <beamWidth>1.0</beamWidth>
                <lifetime>70</lifetime>
                <!-- <explosionEffect>Ring_ExpandY</explosionEffect> -->
                <projectile Class="CombatExtended.ProjectilePropertiesCE">
                  <damageDef>Cut</damageDef>
                  <damageAmountBase>20</damageAmountBase>
                  <!-- <stoppingPower>3</stoppingPower> -->
                  <armorPenetrationSharp>12</armorPenetrationSharp>
                  <armorPenetrationBlunt>50</armorPenetrationBlunt>
                  <isInstant>true</isInstant>
                  <damageFalloff>false</damageFalloff>
                </projectile>
                <thingClass>CombatExtended.Lasers.LaserBeamCE</thingClass>
              </ThingDef>
            </value>
          </match>
        </li>
        <li Class="PatchOperationConditional">
          <xpath>Defs/ThingDef[defName="GW40k_Necron_BeamGraphic"]/thingClass[text()="VEF.Weapons.LaserBeamGraphic"]</xpath>
          <match Class="PatchOperationReplace">
            <xpath>Defs/ThingDef[defName="GW40k_Necron_BeamGraphic"]/thingClass</xpath>
            <value>
              <thingClass>CombatExtended.Lasers.LaserBeamGraphicCE</thingClass>
            </value>
          </match>
        </li>
        <li Class="PatchOperationConditional">
          <xpath>Defs/ThingDef[defName="GW40k_Necron_Disintegrator" and not(verbs/li[starts-with(verbClass,"CombatExtended.")])]</xpath>
          <match Class="PatchOperationSequence">
            <operations>
              <li Class="CombatExtended.PatchOperationMakeGunCECompatible">
                <defName>GW40k_Necron_Disintegrator</defName>
                <statBases>
                  <Bulk>6.75</Bulk>
                  <SightsEfficiency>1</SightsEfficiency>
                  <SwayFactor>1</SwayFactor>
                  <ShotSpread>0.05</ShotSpread>
                </statBases>
                <Properties>
                  <verbClass>CombatExtended.Verb_ShootCE</verbClass>
                  <hasStandardCommand>true</hasStandardCommand>
                  <defaultProjectile>GW40k_Necron_Laser</defaultProjectile>
                  <warmupTime>3.5</warmupTime>
                  <range>36</range>
                  <ticksBetweenBurstShots>4</ticksBetweenBurstShots>
                  <burstShotCount>1</burstShotCount>
                  <!--  only 1 - Crazy op -->
                  <soundCast>Shot_ChargeRifle</soundCast>
                  <soundCastTail>GunTail_Medium</soundCastTail>
                  <muzzleFlashScale>11</muzzleFlashScale>
                  <recoilAmount>0.4</recoilAmount>
                </Properties>
                <FireModes>
                  <aiAimMode>Snapshot</aiAimMode>
                  <aiUseBurstMode>true</aiUseBurstMode>
                </FireModes>
              </li>
              <li Class="PatchOperationAdd">
                <xpath>Defs/ThingDef[defName="GW40k_Necron_Disintegrator"]/modExtensions</xpath>
                <value>
                  <li Class="GW_Frame.Compatibility.CEGaussEnergyPolicy17" />
                </value>
              </li>
            </operations>
          </match>
        </li>
        <li Class="PatchOperationConditional">
          <xpath>Defs/ThingDef[defName="GW40k_Necron_GaussFlayer" and not(verbs/li[starts-with(verbClass,"CombatExtended.")])]</xpath>
          <match Class="PatchOperationSequence">
            <operations>
              <li Class="CombatExtended.PatchOperationMakeGunCECompatible">
                <defName>GW40k_Necron_GaussFlayer</defName>
                <statBases>
                  <Bulk>6.75</Bulk>
                  <SightsEfficiency>1</SightsEfficiency>
                  <SwayFactor>1</SwayFactor>
                  <ShotSpread>0.05</ShotSpread>
                </statBases>
                <Properties>
                  <verbClass>CombatExtended.Verb_ShootCE</verbClass>
                  <hasStandardCommand>true</hasStandardCommand>
                  <defaultProjectile>GW40k_Necron_Gauss</defaultProjectile>
                  <!-- changed from ChargeBullet-->
                  <warmupTime>2.0</warmupTime>
                  <range>27</range>
                  <ticksBetweenBurstShots>4</ticksBetweenBurstShots>
                  <burstShotCount>1</burstShotCount>
                  <soundCast>Shot_ChargeRifle</soundCast>
                  <soundCastTail>GunTail_Medium</soundCastTail>
                  <muzzleFlashScale>11</muzzleFlashScale>
                  <recoilAmount>0.4</recoilAmount>
                </Properties>
                <FireModes>
                  <aiAimMode>Snapshot</aiAimMode>
                  <aiUseBurstMode>true</aiUseBurstMode>
                </FireModes>
              </li>
              <li Class="PatchOperationAdd">
                <xpath>Defs/ThingDef[defName="GW40k_Necron_GaussFlayer"]/modExtensions</xpath>
                <value>
                  <li Class="GW_Frame.Compatibility.CEGaussEnergyPolicy17" />
                </value>
              </li>
            </operations>
          </match>
        </li>
        <li Class="PatchOperationConditional">
          <xpath>Defs/ThingDef[defName="GW40k_Necron_GaussReaper" and not(verbs/li[starts-with(verbClass,"CombatExtended.")])]</xpath>
          <match Class="PatchOperationSequence">
            <operations>
              <li Class="CombatExtended.PatchOperationMakeGunCECompatible">
                <defName>GW40k_Necron_GaussReaper</defName>
                <statBases>
                  <Bulk>8.1</Bulk>
                  <SightsEfficiency>1</SightsEfficiency>
                  <SwayFactor>1</SwayFactor>
                  <ShotSpread>0.05</ShotSpread>
                </statBases>
                <Properties>
                  <verbClass>CombatExtended.Verb_ShootCE</verbClass>
                  <hasStandardCommand>true</hasStandardCommand>
                  <defaultProjectile>GW40k_Necron_Reaper</defaultProjectile>
                  <warmupTime>2.0</warmupTime>
                  <range>15.9</range>
                  <ticksBetweenBurstShots>4</ticksBetweenBurstShots>
                  <burstShotCount>2</burstShotCount>
                  <soundCast>Shot_ChargeRifle</soundCast>
                  <soundCastTail>GunTail_Medium</soundCastTail>
                  <muzzleFlashScale>18</muzzleFlashScale>
                  <ai_IsBuildingDestroyer>true</ai_IsBuildingDestroyer>
                  <recoilAmount>0.4</recoilAmount>
                </Properties>
                <FireModes>
                  <aiAimMode>Snapshot</aiAimMode>
                  <aiUseBurstMode>true</aiUseBurstMode>
                </FireModes>
              </li>
              <li Class="PatchOperationAdd">
                <xpath>Defs/ThingDef[defName="GW40k_Necron_GaussReaper"]/modExtensions</xpath>
                <value>
                  <li Class="GW_Frame.Compatibility.CEGaussEnergyPolicy17" />
                </value>
              </li>
            </operations>
          </match>
        </li>
        <li Class="PatchOperationConditional">
          <xpath>Defs/ThingDef[defName="GW40k_Necron_GaussBlaster" and not(verbs/li[starts-with(verbClass,"CombatExtended.")])]</xpath>
          <match Class="PatchOperationSequence">
            <operations>
              <li Class="CombatExtended.PatchOperationMakeGunCECompatible">
                <defName>GW40k_Necron_GaussBlaster</defName>
                <statBases>
                  <Bulk>11.25</Bulk>
                  <SightsEfficiency>1</SightsEfficiency>
                  <SwayFactor>1</SwayFactor>
                  <ShotSpread>0.05</ShotSpread>
                </statBases>
                <Properties>
                  <verbClass>CombatExtended.Verb_ShootCE</verbClass>
                  <hasStandardCommand>true</hasStandardCommand>
                  <defaultProjectile>GW40k_Necron_Reaper</defaultProjectile>
                  <!-- changed from ChargeBullet-->
                  <warmupTime>2.2</warmupTime>
                  <range>26</range>
                  <ticksBetweenBurstShots>6</ticksBetweenBurstShots>
                  <burstShotCount>2</burstShotCount>
                  <soundCast>Shot_ChargeRifle</soundCast>
                  <soundCastTail>GunTail_Medium</soundCastTail>
                  <muzzleFlashScale>11</muzzleFlashScale>
                  <ai_IsBuildingDestroyer>true</ai_IsBuildingDestroyer>
                  <recoilAmount>0.4</recoilAmount>
                </Properties>
                <FireModes>
                  <aiAimMode>Snapshot</aiAimMode>
                  <aiUseBurstMode>true</aiUseBurstMode>
                </FireModes>
              </li>
              <li Class="PatchOperationAdd">
                <xpath>Defs/ThingDef[defName="GW40k_Necron_GaussBlaster"]/modExtensions</xpath>
                <value>
                  <li Class="GW_Frame.Compatibility.CEGaussEnergyPolicy17" />
                </value>
              </li>
            </operations>
          </match>
        </li>
        <li Class="PatchOperationConditional">
          <xpath>Defs/ThingDef[defName="GW40k_Necron_StaffR" and not(verbs/li[starts-with(verbClass,"CombatExtended.")])]</xpath>
          <match Class="PatchOperationSequence">
            <operations>
              <li Class="CombatExtended.PatchOperationMakeGunCECompatible">
                <defName>GW40k_Necron_StaffR</defName>
                <statBases>
                  <Bulk>4.28</Bulk>
                  <SightsEfficiency>1</SightsEfficiency>
                  <SwayFactor>1</SwayFactor>
                  <ShotSpread>0.05</ShotSpread>
                </statBases>
                <Properties>
                  <verbClass>CombatExtended.Verb_ShootCE</verbClass>
                  <hasStandardCommand>true</hasStandardCommand>
                  <defaultProjectile>GW40k_Necron_Laser</defaultProjectile>
                  <range>19.9</range>
                  <soundCast>Shot_ChargeRifle</soundCast>
                  <burstShotCount>2</burstShotCount>
                  <ticksBetweenBurstShots>18</ticksBetweenBurstShots>
                  <soundCastTail>GunTail_Heavy</soundCastTail>
                  <muzzleFlashScale>9</muzzleFlashScale>
                  <warmupTime>0.8</warmupTime>
                  <ai_IsBuildingDestroyer>true</ai_IsBuildingDestroyer>
                  <recoilAmount>0.4</recoilAmount>
                </Properties>
                <FireModes>
                  <aiAimMode>Snapshot</aiAimMode>
                  <aiUseBurstMode>true</aiUseBurstMode>
                </FireModes>
              </li>
              <li Class="PatchOperationAdd">
                <xpath>Defs/ThingDef[defName="GW40k_Necron_StaffR"]</xpath>
                <value>
                  <modExtensions>
                    <li Class="GW_Frame.Compatibility.CEGaussEnergyPolicy17" />
                  </modExtensions>
                </value>
              </li>
            </operations>
          </match>
        </li>
      </operations>
    </match>
  </Operation>
</Patch>